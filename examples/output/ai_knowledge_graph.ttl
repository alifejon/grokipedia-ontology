grok:AI_Safety a grok_class:abstract ;
    rdfs:label "AI Safety" ;
    grok_prop:hasCategory grok:AI_Research,
        grok:Ethics ;
    grok_prop:hasDescription "A research field focused on making AI systems safe, beneficial, and aligned with human values. Addresses risks from advanced AI systems." ;
    grok_prop:related_to grok:Anthropic ;
    grok_prop:supports grok:Artificial_Intelligence ;
    rdfs:comment "A research field focused on making AI systems safe, beneficial, and aligned with human values. Addresses risks from advanced AI systems." .

grok:Alan_Turing a grok_class:person ;
    rdfs:label "Alan Turing" ;
    grok_prop:birth_year "1912" ;
    grok_prop:death_year "1954" ;
    grok_prop:hasCategory grok:Computer_Science_Pioneers,
        grok:Scientists ;
    grok_prop:hasDescription "British mathematician and computer scientist, considered the father of theoretical computer science and AI. Created the Turing Test." ;
    grok_prop:related_to grok:Artificial_Intelligence ;
    rdfs:comment "British mathematician and computer scientist, considered the father of theoretical computer science and AI. Created the Turing Test." .

grok:Computer_Vision a grok_class:technology ;
    rdfs:label "CV",
        "Computer Vision" ;
    grok_prop:hasCategory grok:AI,
        grok:Image_Processing ;
    grok_prop:hasDescription "A field of AI that trains computers to interpret and understand the visual world. Using digital images and deep learning models, machines can accurately identify and classify objects." ;
    grok_prop:is_a grok:Artificial_Intelligence ;
    rdfs:comment "A field of AI that trains computers to interpret and understand the visual world. Using digital images and deep learning models, machines can accurately identify and classify objects." .

grok:Generative_AI a grok_class:technology ;
    rdfs:label "GenAI",
        "Generative AI" ;
    grok_prop:hasCategory grok:AI,
        grok:Creative_AI,
        grok:Deep_Learning ;
    grok_prop:hasDescription "AI systems capable of generating new content including text, images, audio, and video based on patterns learned from training data." ;
    grok_prop:is_a grok:Artificial_Intelligence ;
    grok_prop:related_to grok:Large_Language_Model ;
    rdfs:comment "AI systems capable of generating new content including text, images, audio, and video based on patterns learned from training data." .

grok:Google_DeepMind a grok_class:organization ;
    rdfs:label "Google DeepMind" ;
    grok_prop:hasCategory grok:AI_Companies,
        grok:Research_Labs ;
    grok_prop:hasDescription "An AI research laboratory that created AlphaGo, AlphaFold, and Gemini. Known for breakthrough research in deep learning and reinforcement learning." ;
    rdfs:comment "An AI research laboratory that created AlphaGo, AlphaFold, and Gemini. Known for breakthrough research in deep learning and reinforcement learning." .

grok:Neural_Network a grok_class:technology ;
    rdfs:label "ANN",
        "Artificial Neural Network",
        "Neural Network" ;
    grok_prop:hasCategory grok:Computer_Science,
        grok:Machine_Learning ;
    grok_prop:hasDescription "A computing system inspired by biological neural networks. It consists of interconnected nodes (neurons) that process information using connectionist approaches." ;
    grok_prop:part_of grok:Deep_Learning ;
    grok_prop:used_for grok:Machine_Learning ;
    rdfs:comment "A computing system inspired by biological neural networks. It consists of interconnected nodes (neurons) that process information using connectionist approaches." .

grok:OpenAI a grok_class:organization ;
    rdfs:label "OpenAI" ;
    grok_prop:founded "2015" ;
    grok_prop:hasCategory grok:AI_Companies,
        grok:Research_Labs ;
    grok_prop:hasDescription "An American artificial intelligence research laboratory. OpenAI created ChatGPT and the GPT series of language models." ;
    grok_prop:headquarters "San Francisco" ;
    grok_prop:related_to grok:Anthropic,
        grok:xAI ;
    rdfs:comment "An American artificial intelligence research laboratory. OpenAI created ChatGPT and the GPT series of language models." .

grok:Reinforcement_Learning a grok_class:technology ;
