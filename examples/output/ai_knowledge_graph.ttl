<http://grokipedia.org/ontology> a owl:Ontology ;
    rdfs:label "Grokipedia Ontology" ;
    rdfs:comment "An ontology derived from Grokipedia knowledge base" .

grok:Geoffrey_Hinton a grok_class:person ;
    rdfs:label "Geoffrey Hinton" ;
    grok_prop:birth_year "1947" ;
    grok_prop:hasCategory grok:AI_Researchers,
        grok:Scientists ;
    grok_prop:hasDescription "British-Canadian cognitive psychologist and computer scientist, known as a 'Godfather of AI'. Pioneer in deep learning and neural networks." ;
    grok_prop:related_to grok:Deep_Learning,
        grok:Google_DeepMind ;
    rdfs:comment "British-Canadian cognitive psychologist and computer scientist, known as a 'Godfather of AI'. Pioneer in deep learning and neural networks." .

grok:Grokipedia a grok_class:work ;
    rdfs:label "Grokipedia" ;
    grok_prop:derived_from grok:Grok,
        grok:xAI ;
    grok_prop:hasCategory grok:AI_Content,
        grok:Encyclopedia ;
    grok_prop:hasDescription "An AI-generated online encyclopedia operated by xAI. Articles are generated by Grok, making it the first major AI-generated encyclopedia." ;
    grok_prop:launched "2025" ;
    grok_prop:operator "xAI" ;
    rdfs:comment "An AI-generated online encyclopedia operated by xAI. Articles are generated by Grok, making it the first major AI-generated encyclopedia." .

grok:Transformer a grok_class:technology ;
    rdfs:label "Transformer" ;
    grok_prop:hasCategory grok:Deep_Learning,
        grok:NLP ;
    grok_prop:hasDescription "A deep learning architecture that uses self-attention mechanisms. Transformers are the basis for models like GPT, BERT, and other modern language models." ;
    grok_prop:is_a grok:Neural_Network ;
    grok_prop:part_of grok:Large_Language_Model ;
    grok_prop:used_for grok:Natural_Language_Processing ;
    rdfs:comment "A deep learning architecture that uses self-attention mechanisms. Transformers are the basis for models like GPT, BERT, and other modern language models." .

grok:Turing_Test a grok_class:abstract ;
    rdfs:label "Turing Test" ;
    grok_prop:derived_from grok:Alan_Turing ;
    grok_prop:hasCategory grok:AI_Theory,
        grok:Philosophy_of_Mind ;
    grok_prop:hasDescription "A test of a machine's ability to exhibit intelligent behavior indistinguishable from a human. Proposed by Alan Turing in 1950." ;
    grok_prop:used_for grok:Artificial_Intelligence ;
    rdfs:comment "A test of a machine's ability to exhibit intelligent behavior indistinguishable from a human. Proposed by Alan Turing in 1950." .

grok:stmt_ChatGPT_is_a_Artificial_Intelligence a rdf:Statement ;
    grok_prop:hasConfidence 9e-01 ;
    rdf:object grok:Artificial_Intelligence ;
    rdf:predicate grok_prop:is_a ;
    rdf:subject grok:ChatGPT .

